{
  "name": "markdown-textgraph-codeblock",
  "scopeName": "markdown.textgraph.codeblock",
  "injectionSelector": "L:text.html.markdown -markup.fenced_code.block.markdown -markup.raw.block.markdown -comment.block.html -meta.embedded.block",
  "patterns": [
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(?=(^|\\G)( {0,3})(?!(?>`{3,})[^`\\r\\n]*`)((`|~)\\4{2,})[ \\t]*(textgraph)(?=$|[ \\t])([^\\r\\n]*)$)",
      "end": "(^|\\G)( {0,3})(\\3\\4*)[ \\t]*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "begin": "(^|\\G)( {0,3})(?!(?>`{3,})[^`\\r\\n]*`)((`|~)\\4{2,})[ \\t]*(textgraph)(?=$|[ \\t])([^\\r\\n]*)$",
          "beginCaptures": {
            "3": {
              "name": "punctuation.definition.markdown"
            },
            "5": {
              "name": "fenced_code.block.language.markdown"
            },
            "6": {
              "name": "fenced_code.block.language.attributes.markdown"
            }
          },
          "while": "(^|\\G)(?! {0,3}\\3\\4*[ \\t]*$)",
          "contentName": "meta.embedded.block.textgraph",
          "patterns": [
            {
              "include": "source.textgraph"
            }
          ]
        }
      ],
      "comment": "The outer rule owns the Markdown fence. The inner while rule unwinds open TextGraph tokens before the same closing delimiter, including an incomplete comment."
    }
  ]
}
