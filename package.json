{
  "name": "@drawmotive/markdown-it-textgraph",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "description": "TextGraph diagrams for Markdown and VitePress",
  "type": "module",
  "license": "MIT",
  "homepage": "https://textgraph.dev/integrations/markdown",
  "bugs": {
    "url": "https://github.com/drawmotive/textgraph/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drawmotive/markdown-textgraph.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./vitepress": {
      "types": "./src/vitepress.d.ts",
      "import": "./src/vitepress.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build": "node tooling/check.mjs",
    "prepack": "node .release/check.cjs --installed && npm test && npm run build",
    "test:browser": "playwright test",
    "release:check": "node .release/check.cjs --ready"
  },
  "dependencies": {
    "@drawmotive/textgraph": "0.2.1"
  },
  "peerDependencies": {
    "markdown-it": "^14.1.0",
    "vitepress": "2.0.0-alpha.19"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "markdown-it": "14.1.0",
    "pngjs": "^7.0.0",
    "preact": "^10.29.8",
    "react": "^19.3.0",
    "search-insights": "^2.17.3",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.19"
  }
}
