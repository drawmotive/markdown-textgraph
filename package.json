{
  "name": "@drawmotive/markdown-it-textgraph",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "TextGraph diagrams for Markdown and VitePress",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drawmotive/markdown-textgraph.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./vitepress": {
      "types": "./src/vitepress.d.ts",
      "import": "./src/vitepress.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build": "node tooling/check.mjs",
    "prepack": "npm test && npm run build"
  },
  "dependencies": {
    "@drawmotive/textgraph": "0.1.0-alpha.1"
  },
  "peerDependencies": {
    "markdown-it": "^14.1.0",
    "vitepress": "2.0.0-alpha.19"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  },
  "devDependencies": {
    "markdown-it": "14.1.0",
    "vitepress": "2.0.0-alpha.19",
    "typescript": "^5.9.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "pngjs": "^7.0.0",
    "@playwright/test": "^1.55.0"
  }
}
